<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TarkovAtlas.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#080C11" />
    <SolidColorBrush x:Key="PanelBg" Color="#0E141B" />
    <SolidColorBrush x:Key="PanelBg2" Color="#111922" />
    <SolidColorBrush x:Key="CardBg" Color="#141C25" />
    <SolidColorBrush x:Key="BorderSoft" Color="#25313D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A4856" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9EAEBB" />
    <SolidColorBrush x:Key="TextMuted" Color="#6D7D8B" />
    <SolidColorBrush x:Key="Accent" Color="#D6A84B" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3B3220" />
    <SolidColorBrush x:Key="Danger" Color="#D85B4A" />
    <SolidColorBrush x:Key="Success" Color="#6FBF8B" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
      <Setter Property="Background" Value="{StaticResource AppBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#18212B" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22303D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0C1117" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#171207" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E6BB60" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B2530" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#2A1715" />
      <Setter Property="Foreground" Value="#F18C7B" />
      <Setter Property="BorderBrush" Value="#5A2B24" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0B1117" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#17212B" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#232D35" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#28343E" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0B1117" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#E60B1017" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{StaticResource BorderSoft}" />
    </Style>
  </Application.Styles>
</Application>
