<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TarkovAtlas.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#080C11" />
    <SolidColorBrush x:Key="PanelBg" Color="#0E141B" />
    <SolidColorBrush x:Key="PanelBg2" Color="#111922" />
    <SolidColorBrush x:Key="CardBg" Color="#141C25" />
    <SolidColorBrush x:Key="BorderSoft" Color="#25313D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A4856" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9EAEBB" />
    <SolidColorBrush x:Key="TextMuted" Color="#6D7D8B" />
    <SolidColorBrush x:Key="Accent" Color="#D6A84B" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3B3220" />
    <SolidColorBrush x:Key="AccentHover" Color="#E6BB60" />
    <SolidColorBrush x:Key="Danger" Color="#D85B4A" />
    <SolidColorBrush x:Key="Success" Color="#6FBF8B" />
    <SolidColorBrush x:Key="HeaderBg" Color="#0B1117" />
    <SolidColorBrush x:Key="DividerBg" Color="#1C2732" />
    <SolidColorBrush x:Key="ButtonBg" Color="#18212B" />
    <SolidColorBrush x:Key="ButtonHoverBg" Color="#22303D" />
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#0C1117" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#0A0F14" />
    <SolidColorBrush x:Key="SurfaceDeepBg" Color="#090D12" />
    <SolidColorBrush x:Key="PanelDeepBg" Color="#0C1219" />
    <SolidColorBrush x:Key="PanelHeaderBg" Color="#101822" />
    <SolidColorBrush x:Key="ListHoverBg" Color="#17212B" />
    <SolidColorBrush x:Key="ListSelectedBg" Color="#232D35" />
    <SolidColorBrush x:Key="ListSelectedHoverBg" Color="#28343E" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#171207" />
    <SolidColorBrush x:Key="OverlayChromeBg" Color="#D90B1017" />
    <SolidColorBrush x:Key="OverlayChromeBorder" Color="#26333F" />
    <SolidColorBrush x:Key="DangerBg" Color="#2A1715" />
    <SolidColorBrush x:Key="DangerBorder" Color="#5A2B24" />
    <SolidColorBrush x:Key="CanvasBg" Color="#0A0F15" />
    <SolidColorBrush x:Key="CardAltBg" Color="#131B24" />
    <SolidColorBrush x:Key="SurfaceRaisedBg" Color="#0D131A" />
    <SolidColorBrush x:Key="GripBg" Color="#59000000" />
    <SolidColorBrush x:Key="GripStroke" Color="#C8D4E0" />
    <SolidColorBrush x:Key="HintText" Color="#B3D7E1E8" />
    <SolidColorBrush x:Key="DangerText" Color="#E08A7C" />
    <SolidColorBrush x:Key="StatusLiveBg" Color="#17231D" />
    <SolidColorBrush x:Key="StatusLiveBorder" Color="#2E4A37" />
    <SolidColorBrush x:Key="StatusLiveText" Color="#A9CEB8" />
    <SolidColorBrush x:Key="StatusIdleText" Color="#8FA0AE" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
      <Setter Property="Background" Value="{StaticResource AppBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource ButtonBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ButtonHoverBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ButtonPressedBg}" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource TextOnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ListHoverBg}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource DangerBg}" />
      <Setter Property="Foreground" Value="{StaticResource DangerText}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource HeaderBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ListHoverBg}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ListSelectedBg}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ListSelectedHoverBg}" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource HeaderBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{StaticResource OverlayChromeBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{StaticResource BorderSoft}" />
    </Style>

    <!-- Window caption buttons (min/max/close): Fluent's template snaps between
         states. A foreground + background transition on the button and its
         ContentPresenter makes hover/press smooth instead of harsh. -->
    <Style Selector="CaptionButtons Button">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="CaptionButtons Button /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
