<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TarkovAtlas.Controls"
        x:Class="TarkovAtlas.OverlayWindow"
        Title="Tarkov Atlas Overlay"
        Width="260" Height="260"
        MinWidth="120" MinHeight="120"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <!-- Borderless square cut-out centred on the player position. The window
       follows the newest screenshot automatically; drag with the left mouse
       button to pan the map, right-drag to move the window, wheel to zoom,
       Ctrl+Alt+L toggles click-through. -->
  <Grid x:Name="Root" Background="Transparent">
    <controls:MapCanvas x:Name="OverlayMap" Compact="True" IsHitTestVisible="False" />
    <TextBlock x:Name="HintText" Text=""
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,4,0,0" FontSize="9" Foreground="{StaticResource HintText}"
               IsHitTestVisible="False" />
  </Grid>
</Window>
